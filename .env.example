# Cloudflare Workers AI (FLUX.1 schnell) - used by server/api/generate.post.ts
# Account ID: Cloudflare dashboard > Workers & Pages. Token: create an API token with the "Workers AI" permission.
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_API_TOKEN=

# Optional: max image generations per UTC day (default 50). Cloudflare's free tier is 10,000 Neurons/day.
# NUXT_DAILY_GENERATION_LIMIT=50

# Optional: Buy Me a Coffee link shown in the header and at the daily limit. Set empty to hide.
# NUXT_PUBLIC_SUPPORT_URL=https://buymeacoffee.com/solomonmurf
